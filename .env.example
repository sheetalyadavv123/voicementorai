# Copy to .env and fill in real values. See docs/setup.md for where to get each key.

# --- Database ---
# Local dev: docker compose up -d postgres  (matches this connection string out of the box)
DATABASE_URL="postgresql://voicementor:voicementor@localhost:5432/voicementor?schema=public"

# --- NextAuth --- (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- Backend API --- (must match backend/.env's INTERNAL_API_SECRET)
NEXT_PUBLIC_BACKEND_URL="http://localhost:8000"
BACKEND_INTERNAL_API_SECRET=""

# --- LiveKit --- (frontend only needs the public wss:// URL to join rooms)
NEXT_PUBLIC_LIVEKIT_URL="wss://your-project.livekit.cloud"
