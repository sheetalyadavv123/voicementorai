# Copy to .env and fill in real values. See docs/setup.md for where to get each key.

ENVIRONMENT="development"
CORS_ORIGINS='["http://localhost:3000"]'

# Shared secret with the Next.js BFF (app/api/*/route.ts) — generate with:
# openssl rand -base64 32
INTERNAL_API_SECRET=""

# --- Database --- (same Postgres as the frontend's DATABASE_URL, async driver)
DATABASE_URL="postgresql+asyncpg://voicementor:voicementor@localhost:5432/voicementor"

# --- AI provider toggle --- "openai" or "google". Switch providers by
# changing this one variable — no code or dependency changes needed, both
# are always installed. See docs/setup.md for the tradeoffs.
AI_PROVIDER="openai"

# --- OpenAI --- (https://platform.openai.com/api-keys)
# Used for both the live voice LLM (agent/worker.py, via livekit-plugins-openai)
# and one-shot text/structured generation (agent/llm.py — quiz gen/eval,
# summarization, translation) plus embeddings (rag/embeddings.py).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.4-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# --- Google Gemini (only used when AI_PROVIDER=google) ---
# Vertex AI with a GCP service account ("secrets.json" approach) is the
# default (GOOGLE_USE_VERTEXAI=true) — set GOOGLE_CLOUD_PROJECT and
# GOOGLE_APPLICATION_CREDENTIALS to the service account JSON's path, loaded
# explicitly by agent/llm.py, not via ambient ADC discovery. This bills
# Gemini usage to that GCP project. "global" is the usual recommendation
# for location (a pinned region 404s if a model isn't published there);
# if billing was enabled recently and you still see 429s on "global", try a
# specific region like "us-central1" — quota upgrades can propagate
# unevenly across regions. Set GOOGLE_USE_VERTEXAI=false to use a plain
# AI Studio key instead (GEMINI_API_KEY, from https://aistudio.google.com/apikey) —
# decouples entirely from any GCP project's Vertex quota, but check what
# quota that key actually has: newly-created AI Studio accounts have been
# observed capped as low as 20 requests/day on the free tier.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
GOOGLE_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="global"
GOOGLE_APPLICATION_CREDENTIALS=""

# --- LiveKit --- (https://cloud.livekit.io)
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_URL="wss://your-project.livekit.cloud"

# --- Deepgram --- (https://console.deepgram.com)
DEEPGRAM_API_KEY=""

# --- ElevenLabs --- (https://elevenlabs.io/app/settings/api-keys)
# Free-tier keys can only use ElevenLabs' current default voice set, not the
# full shared Voice Library (that 402s on synthesis). Check what your key
# can actually use: curl -H "xi-api-key: $KEY" https://api.elevenlabs.io/v1/voices
ELEVENLABS_API_KEY=""
ELEVENLABS_DEFAULT_VOICE_ID="EXAVITQu4vr4xnSDxMaL"

# --- Storage --- (leave blank in local dev to fall back to backend/uploads/)
GCS_BUCKET_NAME=""
GCS_PROJECT_ID=""
LOCAL_UPLOAD_DIR="uploads"
